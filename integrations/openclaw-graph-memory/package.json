{
  "name": "@anurag1/openclaw-graph-memory",
  "version": "0.1.0",
  "private": false,
  "description": "A local, provenance-aware graph memory plugin for OpenClaw.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/store.js && node --test test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "benchmark": "node benchmarks/retrieval-benchmark.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  }
}
